# Copy to .env and fill in. These stay on the server — never in frontend code.

PORT=3000

# SQLite database file (created automatically, demo data seeded on first run).
# DATABASE_PATH=./data/lexitube.db

# --- AI vocabulary extraction (recommended) ---------------------------------
# With a key, Claude reads the transcript and picks B1–C1 items with Arabic
# meanings that follow the video's actual context. Without it, the app uses
# its built-in curated dictionary (general meanings only).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# --- Text-to-speech (optional) ----------------------------------------------
# Without these the browser's built-in voices are used.
# TTS_PROVIDER=openai        # openai | elevenlabs | google
# TTS_API_KEY=
# TTS_VOICE=
# TTS_MODEL=

# --- Transcript service fallback (optional) ---------------------------------
# Used only if direct YouTube caption download fails. {id} = YouTube video id.
# Must return [{start, dur, text}] or {segments: [...]}.
# TRANSCRIPT_API_URL=https://your-transcript-service.example/transcript/{id}
# TRANSCRIPT_API_KEY=
