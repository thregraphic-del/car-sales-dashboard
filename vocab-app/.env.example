# Copy this file to ".env" (same folder) and fill in your own values.
# .env stays on your computer: it is git-ignored, never sent to the browser,
# and never included in the zip.

PORT=3000

# --- AI explanations via OpenRouter (optional) -------------------------------
# Get a key at https://openrouter.ai/keys
# Without a key LexiTube works fully offline with its built-in dictionary.
OPENROUTER_API_KEY=
# Any OpenRouter model id. Leave empty for "openrouter/auto".
# Examples: openai/gpt-4o-mini · google/gemini-2.0-flash-001 · anthropic/claude-3.5-haiku
OPENROUTER_MODEL=

# SQLite database file (created automatically, demo data on first run).
# DATABASE_PATH=./data/lexitube.db

# --- Text-to-speech (optional) ----------------------------------------------
# Without these the browser's built-in voices are used.
# TTS_PROVIDER=openai        # openai | elevenlabs | google
# TTS_API_KEY=
# TTS_VOICE=

# --- Transcript service fallback (optional) ---------------------------------
# Used only if direct YouTube caption download fails. {id} = YouTube video id.
# TRANSCRIPT_API_URL=https://your-transcript-service.example/transcript/{id}
# TRANSCRIPT_API_KEY=
